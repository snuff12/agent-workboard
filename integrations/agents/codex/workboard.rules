# Agent Workboard commands reach the local board service through a Unix socket, which the Codex
# sandbox blocks. Ordinary board work runs outside the sandbox without a prompt; the service still
# validates claims, revisions, and retries. Destructive, broad, or user-only commands ask first.
# The installer appends the same rules for the absolute paths of the installed executable.
prefix_rule(
    pattern = ["workboard", "automation", "preset", ["list", "show", "apply"]],
    decision = "allow",
    justification = "Preset selection checks task ownership and revisions and does not start agents.",
)
prefix_rule(
    pattern = ["workboard", "automation", "preset", ["save", "delete"]],
    decision = "prompt",
    justification = "Changing the shared preset library belongs to the user.",
)
prefix_rule(
    pattern = ["workboard", "automation", ["show", "list", "defaults", "fingerprint", "report"]],
    decision = "allow",
    justification = "Stage reports use a private handoff and never approve or complete a task.",
)
prefix_rule(
    pattern = ["workboard", "automation", ["configure", "set-defaults", "start", "pause", "resume", "disable", "resolve", "worker", "submit-report", "settle"]],
    decision = "prompt",
    justification = "Workflow controls can launch agents or change execution authority.",
)
prefix_rule(
    pattern = ["workboard", ["project", "task", "inbox", "template", "view", "board", "events", "doctor", "agent", "trash"]],
    decision = "allow",
    justification = "Board reads and task updates go through the board service.",
    match = [["workboard", "task", "show", "TASK", "--json"], ["workboard", "agent", "context"]],
)
prefix_rule(
    pattern = ["workboard", "task", ["delete", "complete", "decide", "cancel"]],
    decision = "prompt",
    justification = "Deleting, completing, and canceling tasks and deciding reviews belong to the user.",
)
prefix_rule(
    pattern = ["workboard", "trash", ["restore", "delete", "empty"]],
    decision = "prompt",
    justification = "Restoring deleted work and emptying the trash belong to the user.",
)
prefix_rule(
    pattern = ["workboard", ["project", "template", "view"], "delete"],
    decision = "prompt",
    justification = "Deleting board data needs the user's approval.",
)
prefix_rule(
    pattern = ["workboard", "inbox", ["promote", "dismiss"]],
    decision = "prompt",
    justification = "The user sorts the inbox.",
)
prefix_rule(
    pattern = ["workboard", ["rpc", "backup", "export", "plugin", "serve"]],
    decision = "prompt",
    justification = "Raw requests, backups, exports, plugins, and the service need the user's approval.",
    match = [["workboard", "backup", "restore", "FILE"]],
)
